# Credentials for paint_rl. Copy to `.env` and export before launching:
#   set -a && . ./.env && set +a

# Tinker, for the policy and the training verifier (thinkingmachines/Inkling-Small).
TINKER_API_KEY=

# Gemini, for the strong held-out evaluator (gemini-3.8-flash). The plain
# Gemini API is enough here: the evaluator is scored from the number it prints,
# not from logprobs.
GEMINI_API_KEY=
