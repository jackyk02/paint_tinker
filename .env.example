# Credentials for paint_rl. Copy to `.env` and export before launching:
#   set -a && . ./.env && set +a

# Tinker: the policy and the training reward model (thinkingmachines/Inkling-Small).
TINKER_API_KEY=

# DeepSeek (https://api.deepseek.com): the held-out evaluator, DeepSeek-V4.1-Flash
# (`deepseek-flash`). Only eval_checkpoints.py needs it; Tinker serves the model
# but takes no images for it.
DEEPSEEK_API_KEY=
